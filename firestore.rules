rules_version = '2';
// 통통 가이드 게시판 보안 규칙
// - 누구나 읽기, 익명 로그인한 사람만 쓰기
// - 글은 30초, 댓글은 10초에 한 번 (도배 방지)
// - 내 글·댓글만 지우기, 운영자(admins 컬렉션)는 모두 지우기
// - 공감·신고는 한 사람당 한 번
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function okText(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function okAuthor(d) {
      return d.nick is string && d.nick.size() > 0 && d.nick.size() <= 20
        && d.badges is list && d.badges.size() <= 3
        && d.uid == me() && d.createdAt == request.time;
    }
    function cooled(field, secs) {
      return !exists(userDoc())
        || !(field in get(userDoc()).data)
        || request.time > get(userDoc()).data[field] + duration.value(secs, 's');
    }
    function stamped(field) { return getAfter(userDoc()).data[field] == request.time; }
    function keepOrNow(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == request.time
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['lastPostAt', 'lastCommentAt'])
        && keepOrNow('lastPostAt') && keepOrNow('lastCommentAt');
    }

    match /posts/{pid} {
      function likePath() { return /databases/$(database)/documents/posts/$(pid)/likes/$(me()); }
      function reportPath() { return /databases/$(database)/documents/posts/$(pid)/reports/$(me()); }
      function same(f) { return request.resource.data[f] == resource.data[f]; }
      function likeUp() {
        return request.resource.data.likeCount == resource.data.likeCount + 1
          && same('commentCount') && same('reportCount')
          && !exists(likePath()) && existsAfter(likePath());
      }
      function likeDown() {
        return request.resource.data.likeCount == resource.data.likeCount - 1
          && same('commentCount') && same('reportCount')
          && exists(likePath()) && !existsAfter(likePath());
      }
      function reportUp() {
        return request.resource.data.reportCount == resource.data.reportCount + 1
          && same('likeCount') && same('commentCount')
          && !exists(reportPath()) && existsAfter(reportPath());
      }
      function commentStep() {
        return same('likeCount') && same('reportCount') && (
          (request.resource.data.commentCount == resource.data.commentCount + 1 && stamped('lastCommentAt'))
          || request.resource.data.commentCount == resource.data.commentCount - 1
        );
      }

      allow read: if true;
      allow create: if signedIn() && cooled('lastPostAt', 30) && stamped('lastPostAt')
        && request.resource.data.keys().hasOnly(['cat', 'title', 'body', 'nick', 'badges', 'uid', 'createdAt', 'likeCount', 'commentCount', 'reportCount'])
        && request.resource.data.cat in ['꿀팁', '자유', '질문', '정보', '분실물']
        && okText(request.resource.data.title, 60)
        && okText(request.resource.data.body, 2000)
        && okAuthor(request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'reportCount'])
        && (likeUp() || likeDown() || reportUp() || commentStep());
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && cooled('lastCommentAt', 10) && stamped('lastCommentAt')
          && request.resource.data.keys().hasOnly(['body', 'nick', 'badges', 'uid', 'createdAt'])
          && okText(request.resource.data.body, 500)
          && okAuthor(request.resource.data);
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      }
      match /likes/{uid} {
        allow read: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0;
        allow delete: if signedIn() && me() == uid;
      }
      match /reports/{uid} {
        allow read: if isAdmin();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0;
      }
    }

    // 꿀팁 따봉·조회수 (오늘의 HOT 이슈)
    // stats/{t_꿀팁id 또는 p_글id}: title, likes, views, day(한국 날짜 번호), dl(오늘 따봉), dv(오늘 조회)
    // - 조회는 한 번에 1씩만, 따봉은 사람마다 한 번(likes/{uid}와 함께 바뀌어야 함)
    // - day는 서버 시간으로 계산한 오늘이어야 함 (날짜를 속여 오늘 숫자를 지우지 못하게)
    match /stats/{k} {
      function todayNum() { return math.floor((request.time.toMillis() + 32400000) / 86400000); }
      function likeP() { return /databases/$(database)/documents/stats/$(k)/likes/$(me()); }
      function n() { return request.resource.data; }
      function o() { return resource.data; }
      function sameDay() { return n().day == o().day; }
      function viewUp() {
        return n().views == o().views + 1 && n().likes == o().likes
          && ((sameDay() && n().dv == o().dv + 1 && n().dl == o().dl) || (!sameDay() && n().dv == 1 && n().dl == 0));
      }
      function likeUp() {
        return n().likes == o().likes + 1 && n().views == o().views
          && !exists(likeP()) && existsAfter(likeP())
          && ((sameDay() && n().dl == o().dl + 1 && n().dv == o().dv) || (!sameDay() && n().dl == 1 && n().dv == 0));
      }
      function likeDown() {
        return n().likes == o().likes - 1 && n().views == o().views
          && exists(likeP()) && !existsAfter(likeP())
          && ((sameDay() && n().dv == o().dv && (n().dl == o().dl - 1 || (o().dl == 0 && n().dl == 0)))
              || (!sameDay() && n().dl == 0 && n().dv == 0));
      }
      allow read: if true;
      allow create: if signedIn() && k.matches('^[tp]_[A-Za-z0-9_-]{1,40}$')
        && n().keys().hasOnly(['title', 'likes', 'views', 'day', 'dl', 'dv'])
        && n().title is string && n().title.size() <= 80
        && n().day == todayNum()
        && ((n().views == 1 && n().dv == 1 && n().likes == 0 && n().dl == 0)
            || (n().likes == 1 && n().dl == 1 && n().views == 0 && n().dv == 0 && existsAfter(likeP())));
      allow update: if signedIn()
        && n().diff(o()).affectedKeys().hasOnly(['likes', 'views', 'day', 'dl', 'dv'])
        && n().day == todayNum()
        && (viewUp() || likeUp() || likeDown());
      match /likes/{uid} {
        function st() { return /databases/$(database)/documents/stats/$(k); }
        allow read: if signedIn() && me() == uid;
        // 따봉 표시는 stats 숫자가 같이 1 오를 때만, 취소는 같이 1 내릴 때만
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0
          && ((!exists(st()) && getAfter(st()).data.likes == 1)
              || (exists(st()) && getAfter(st()).data.likes == get(st()).data.likes + 1));
        allow delete: if signedIn() && me() == uid
          && exists(st()) && getAfter(st()).data.likes == get(st()).data.likes - 1;
      }
    }

    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
    }
  }
}
