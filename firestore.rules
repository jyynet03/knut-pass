rules_version = '2';
// 통통 가이드 게시판 보안 규칙
// - 누구나 읽기, 익명 로그인한 사람만 쓰기
// - 글은 30초, 댓글은 10초에 한 번 (도배 방지)
// - 내 글·댓글만 지우기, 운영자(admins 컬렉션)는 모두 지우기
// - 공감·신고는 한 사람당 한 번
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function okText(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function okAuthor(d) {
      return d.nick is string && d.nick.size() > 0 && d.nick.size() <= 20
        && d.badges is list && d.badges.size() <= 3
        && d.uid == me() && d.createdAt == request.time;
    }
    function cooled(field, secs) {
      return !exists(userDoc())
        || !(field in get(userDoc()).data)
        || request.time > get(userDoc()).data[field] + duration.value(secs, 's');
    }
    function stamped(field) { return getAfter(userDoc()).data[field] == request.time; }
    function keepOrNow(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == request.time
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['lastPostAt', 'lastCommentAt'])
        && keepOrNow('lastPostAt') && keepOrNow('lastCommentAt');
    }

    match /posts/{pid} {
      function likePath() { return /databases/$(database)/documents/posts/$(pid)/likes/$(me()); }
      function reportPath() { return /databases/$(database)/documents/posts/$(pid)/reports/$(me()); }
      function same(f) { return request.resource.data[f] == resource.data[f]; }
      function likeUp() {
        return request.resource.data.likeCount == resource.data.likeCount + 1
          && same('commentCount') && same('reportCount')
          && !exists(likePath()) && existsAfter(likePath());
      }
      function likeDown() {
        return request.resource.data.likeCount == resource.data.likeCount - 1
          && same('commentCount') && same('reportCount')
          && exists(likePath()) && !existsAfter(likePath());
      }
      function reportUp() {
        return request.resource.data.reportCount == resource.data.reportCount + 1
          && same('likeCount') && same('commentCount')
          && !exists(reportPath()) && existsAfter(reportPath());
      }
      function commentStep() {
        return same('likeCount') && same('reportCount') && (
          (request.resource.data.commentCount == resource.data.commentCount + 1 && stamped('lastCommentAt'))
          || request.resource.data.commentCount == resource.data.commentCount - 1
        );
      }

      allow read: if true;
      allow create: if signedIn() && cooled('lastPostAt', 30) && stamped('lastPostAt')
        && request.resource.data.keys().hasOnly(['cat', 'title', 'body', 'nick', 'badges', 'uid', 'createdAt', 'likeCount', 'commentCount', 'reportCount', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 300000 && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')))
        && request.resource.data.cat in ['꿀팁', '질문', '정보']
        && okText(request.resource.data.title, 60)
        && okText(request.resource.data.body, 2000)
        && okAuthor(request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'reportCount'])
        && (likeUp() || likeDown() || reportUp() || commentStep());
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && cooled('lastCommentAt', 10) && stamped('lastCommentAt')
          && request.resource.data.keys().hasOnly(['body', 'nick', 'badges', 'uid', 'createdAt'])
          && okText(request.resource.data.body, 500)
          && okAuthor(request.resource.data);
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      }
      match /likes/{uid} {
        allow read: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0;
        allow delete: if signedIn() && me() == uid;
      }
      match /reports/{uid} {
        allow read: if isAdmin();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0;
      }
    }

    // 꿀팁 따봉·조회수 (오늘의 HOT 이슈)
    // stats/{t_꿀팁id 또는 p_글id}: title, likes, views, day(한국 날짜 번호), dl(오늘 따봉), dv(오늘 조회)
    // - 조회는 한 번에 1씩만, 따봉은 사람마다 한 번(likes/{uid}와 함께 바뀌어야 함)
    // - day는 서버 시간으로 계산한 오늘이어야 함 (날짜를 속여 오늘 숫자를 지우지 못하게)
    match /stats/{k} {
      function todayNum() { return math.floor((request.time.toMillis() + 32400000) / 86400000); }
      function likeP() { return /databases/$(database)/documents/stats/$(k)/likes/$(me()); }
      function n() { return request.resource.data; }
      function o() { return resource.data; }
      function sameDay() { return n().day == o().day; }
      function viewUp() {
        return n().views == o().views + 1 && n().likes == o().likes
          && ((sameDay() && n().dv == o().dv + 1 && n().dl == o().dl) || (!sameDay() && n().dv == 1 && n().dl == 0));
      }
      function likeUp() {
        return n().likes == o().likes + 1 && n().views == o().views
          && !exists(likeP()) && existsAfter(likeP())
          && ((sameDay() && n().dl == o().dl + 1 && n().dv == o().dv) || (!sameDay() && n().dl == 1 && n().dv == 0));
      }
      function likeDown() {
        return n().likes == o().likes - 1 && n().views == o().views
          && exists(likeP()) && !existsAfter(likeP())
          && ((sameDay() && n().dv == o().dv && (n().dl == o().dl - 1 || (o().dl == 0 && n().dl == 0)))
              || (!sameDay() && n().dl == 0 && n().dv == 0));
      }
      allow read: if true;
      allow create: if signedIn() && k.matches('^[tp]_[A-Za-z0-9_-]{1,40}$')
        && n().keys().hasOnly(['title', 'likes', 'views', 'day', 'dl', 'dv'])
        && n().title is string && n().title.size() <= 80
        && n().day == todayNum()
        && ((n().views == 1 && n().dv == 1 && n().likes == 0 && n().dl == 0)
            || (n().likes == 1 && n().dl == 1 && n().views == 0 && n().dv == 0 && existsAfter(likeP())));
      allow update: if signedIn()
        && n().diff(o()).affectedKeys().hasOnly(['likes', 'views', 'day', 'dl', 'dv'])
        && n().day == todayNum()
        && (viewUp() || likeUp() || likeDown());
      match /likes/{uid} {
        function st() { return /databases/$(database)/documents/stats/$(k); }
        allow read: if signedIn() && me() == uid;
        // 따봉 표시는 stats 숫자가 같이 1 오를 때만, 취소는 같이 1 내릴 때만
        allow create: if signedIn() && me() == uid && request.resource.data.keys().size() == 0
          && ((!exists(st()) && getAfter(st()).data.likes == 1)
              || (exists(st()) && getAfter(st()).data.likes == get(st()).data.likes + 1));
        allow delete: if signedIn() && me() == uid
          && exists(st()) && getAfter(st()).data.likes == get(st()).data.likes - 1;
      }
    }

    // 오늘 많이 찾는 키워드: kw/{한국 날짜 번호}/k/{키워드} 문서마다 {n: 횟수}
    // - 오늘 날짜 아래에만 쓸 수 있음 (다음 날은 새 날짜라 순위가 처음부터 시작)
    // - 한 번에 1씩만 올릴 수 있음, 키워드는 20자까지
    match /kw/{d}/k/{w} {
      function kwToday() { return math.floor((request.time.toMillis() + 32400000) / 86400000); }
      allow read: if true;
      allow create: if signedIn() && int(d) == kwToday() && w.size() <= 20
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && int(d) == kwToday()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // 닉네임 예약: nicks/{소문자 닉네임} = {uid}. 이미 있으면 다른 사람은 못 씀(중복 금지)
    match /nicks/{k} {
      allow read: if true;
      allow create: if signedIn() && k.size() >= 2 && k.size() <= 12
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // 프로필: 닉네임과 작은 사진(폰에서 줄인 데이터)만. 닉네임은 내가 예약한 것이어야 함
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['nick', 'photo', 'updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 12
        && getAfter(/databases/$(database)/documents/nicks/$(request.resource.data.nick.lower())).data.uid == me()
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 120000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // 목표 달성 업적: 인증 사진·달성 날짜 필수, 본인만 올리고 지움, 신고 한 사람당 한 번
    match /achievements/{aid} {
      function arp() { return /databases/$(database)/documents/achievements/$(aid)/reports/$(me()); }
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'title', 'target', 'unit', 'doneAt', 'photo', 'createdAt', 'reportCount'])
        && request.resource.data.uid == me()
        && okText(request.resource.data.title, 40)
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 12
        && (request.resource.data.target == null || request.resource.data.target is int)
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 6
        && request.resource.data.doneAt is string && request.resource.data.doneAt.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.photo is string && request.resource.data.photo.size() > 1000 && request.resource.data.photo.size() <= 300000
        && request.resource.data.createdAt == request.time && request.resource.data.reportCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(arp()) && existsAfter(arp());
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      match /reports/{u} {
        allow read: if isAdmin();
        allow create: if signedIn() && me() == u && request.resource.data.keys().size() == 0;
      }
    }

    // 학생이 등록하는 꿀팁장소: 필수 정보 확인, 네이버 지도 링크만, 글과 같은 30초 간격
    match /places/{pid} {
      function prp() { return /databases/$(database)/documents/places/$(pid)/reports/$(me()); }
      allow read: if true;
      allow create: if signedIn() && cooled('lastPostAt', 30) && stamped('lastPostAt')
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'n', 'c', 'z', 'a', 'l', 'hrs', 'pos', 'm', 'p', 't', 'createdAt', 'reportCount'])
        && request.resource.data.uid == me()
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 12
        && okText(request.resource.data.n, 30)
        && request.resource.data.c in ['eat', 'cafe', 'conv', 'pub', 'print', 'laundry', 'pc', 'karaoke', 'gym', 'mart', 'etc', 'spot']
        && request.resource.data.z in ['대학가', '캠퍼스', '시내']
        && okText(request.resource.data.a, 80)
        && request.resource.data.l is string && request.resource.data.l.size() <= 300
        && request.resource.data.l.matches('^https://(naver[.]me|map[.]naver[.]com|m[.]place[.]naver[.]com|m[.]map[.]naver[.]com)/.*')
        && request.resource.data.hrs is string && request.resource.data.hrs.size() <= 160
        && request.resource.data.pos is list && request.resource.data.pos.size() == 2
        && request.resource.data.pos[0] is number && request.resource.data.pos[1] is number
        && request.resource.data.m is string && request.resource.data.m.size() <= 30
        && request.resource.data.p is string && request.resource.data.p.size() <= 20
        && okText(request.resource.data.t, 120)
        && request.resource.data.createdAt == request.time && request.resource.data.reportCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(prp()) && existsAfter(prp());
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      match /reports/{u} {
        allow read: if isAdmin();
        allow create: if signedIn() && me() == u && request.resource.data.keys().size() == 0;
      }
    }

    // 꿀팁 댓글: tipcomments/{꿀팁id}/c/{댓글}. 게시판 댓글과 같은 10초 간격
    match /tipcomments/{tid}/c/{cid} {
      allow read: if true;
      allow create: if signedIn() && tid.matches('^[A-Za-z0-9_-]{1,40}$')
        && cooled('lastCommentAt', 10) && stamped('lastCommentAt')
        && request.resource.data.keys().hasOnly(['body', 'nick', 'uid', 'createdAt'])
        && okText(request.resource.data.body, 500)
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 20
        && request.resource.data.uid == me() && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // 장소 정보 고치기(위키): edits/{장소} = 지금 내용, edits/{장소}/h = 수정 기록. 닉네임 필수, 30초 간격
    function okEdit(d) {
      return d.keys().hasOnly(['n', 'note', 'menu', 'price', 'hrs', 'uid', 'nick', 'at'])
        && okText(d.n, 40)
        && d.note is string && d.note.size() <= 120
        && d.menu is string && d.menu.size() <= 40
        && d.price is string && d.price.size() <= 30
        && d.hrs is string && d.hrs.size() <= 160
        && d.uid == me() && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 12
        && d.at == request.time;
    }
    match /edits/{k} {
      allow read: if true;
      allow create, update: if signedIn() && cooled('lastPostAt', 30) && stamped('lastPostAt') && okEdit(request.resource.data);
      allow delete: if isAdmin();
      match /h/{hid} {
        allow read: if true;
        allow create: if signedIn() && stamped('lastPostAt') && okEdit(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    // 오늘 방문자 수: visits/{한국 날짜 번호} = {n}. 한 번에 1씩만
    match /visits/{d} {
      function vToday() { return math.floor((request.time.toMillis() + 32400000) / 86400000); }
      allow read: if true;
      allow create: if signedIn() && int(d) == vToday()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && int(d) == vToday()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
    }
  }
}
